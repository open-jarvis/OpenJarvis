<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared spacing/card/status vocabulary for the restyled shell. Every
        page added or restyled in this pass should reference these instead
        of inlining brushes/margins, so the shell reads as one system rather
        than four independently-styled pages. Native Fluent idiom (system
        theme brushes, stock corner radii) — not a clone of the React
        client's custom Tailwind CSS.
    -->

    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceSM">8</x:Double>
    <x:Double x:Key="SpaceMD">12</x:Double>
    <x:Double x:Key="SpaceLG">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>

    <!-- Card: the base container for grouped content (Settings sections,
         connector rows, agent rows, stat tiles all build on this). -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Stat tile: Dashboard's energy/cost numbers. Slightly tighter padding
         than a full card since several sit side by side. -->
    <Style x:Key="StatTileBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinWidth" Value="150" />
    </Style>

    <Style x:Key="StatTileValueStyle" TargetType="TextBlock">
        <Setter Property="Style" Value="{StaticResource TitleTextBlockStyle}" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="StatTileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Status-dot brushes. Fill is set per-item via a converter (status
         varies per row), the shape itself is this fixed small-ellipse
         style. Colors follow the existing InfoBar severity vocabulary so
         they read consistently with ErrorBar/SetupError elsewhere in the
         shell. -->
    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>

    <SolidColorBrush x:Key="StatusIdleBrush" Color="{ThemeResource SystemBaseMediumColor}" />
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="StatusPausedBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#0F7B0F" />

    <!-- Hover-reveal action buttons (per-message copy, etc.): small, flat,
         only emphasized on pointer-over. -->
    <Style x:Key="FlatIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>

</ResourceDictionary>
