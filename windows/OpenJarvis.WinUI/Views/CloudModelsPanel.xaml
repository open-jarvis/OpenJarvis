<UserControl
    x:Class="OpenJarvis.WinUI.Views.CloudModelsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenJarvis.WinUI.Models">
    <StackPanel Spacing="8">
        <InfoBar
            x:Name="ErrorBar"
            Severity="Error"
            IsOpen="False"
            IsClosable="True" />

        <ItemsControl x:Name="ProviderList">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CloudKeyRow">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                FontSize="16"
                                VerticalAlignment="Center"
                                Glyph="&#xE753;" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ProviderName}" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Connected"
                                    Visibility="{x:Bind IsConnected, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource StatusSuccessBrush}" />
                            </StackPanel>

                            <PasswordBox
                                Grid.Column="2"
                                Tag="{x:Bind EnvVarName}"
                                PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                                PasswordRevealMode="Peek"
                                LostFocus="KeyBox_LostFocus"
                                AutomationProperties.Name="{x:Bind ProviderName}" />

                            <Button
                                Grid.Column="3"
                                Content="Remove"
                                Tag="{x:Bind EnvVarName}"
                                Visibility="{x:Bind IsConnected, Mode=OneWay}"
                                Click="Remove_Click"
                                AutomationProperties.Name="{x:Bind ProviderName}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            Text="Keys are written to cloud-keys.env on this device and sent to the local OpenJarvis backend only."
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.8"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
