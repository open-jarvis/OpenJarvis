<UserControl
    x:Class="OpenJarvis.WinUI.Views.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OpenJarvis.WinUI.Views">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" SizeChanged="Scroller_SizeChanged">
            <Grid x:Name="ContentHost" Padding="24">
                <StackPanel
                    x:Name="ConsentPanel"
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    Spacing="24"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <Border
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            CornerRadius="16"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon
                                Glyph="&#xE945;"
                                FontSize="30"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Text="Set up local AI"
                            Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Opacity="0.8"
                            Text="Nothing is installed, started, or downloaded until you confirm." />
                    </StackPanel>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                        <StackPanel Spacing="20">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Glyph="&#xE896;"
                                    FontSize="22"
                                    VerticalAlignment="Top"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock
                                        Text="Allow local model setup?"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="ConsentDetailText"
                                        TextWrapping="Wrap"
                                        Opacity="0.8" />
                                </StackPanel>
                            </Grid>

                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Message="You can stop setup at any time with Change inference source. OpenJarvis then returns here and does not continue until you confirm again." />

                            <TextBlock
                                x:Name="ConsentErrorText"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <Button
                                x:Name="ConsentButton"
                                HorizontalAlignment="Stretch"
                                MinHeight="40"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Use Foundry Local and continue"
                                Click="ConsentButton_Click"
                                AccessKey="U"
                                AutomationProperties.Name="Use Foundry Local and continue" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="ProgressPanel"
                    MaxWidth="480"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,32" HorizontalAlignment="Center" Spacing="6">
                        <Ellipse x:Name="LogoMark" Width="64" Height="64" HorizontalAlignment="Center" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Text="OpenJarvis"
                            Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="SubtitleText"
                            HorizontalAlignment="Center"
                            Opacity="0.8"
                            Text="Setting up your local AI…"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <views:SetupStepRow x:Name="EngineRow" Label="Inference Engine" Glyph="&#xE945;" />
                    <views:SetupStepRow x:Name="ModelRow" Label="AI Model" Glyph="&#xE8F1;" />
                    <views:SetupStepRow x:Name="ServerRow" Label="API Server" Glyph="&#xE968;" />

                    <InfoBar
                        x:Name="ErrorBar"
                        Margin="0,16,0,0"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Error"
                        Title="Setup could not finish"
                        AutomationProperties.LiveSetting="Assertive" />

                    <TextBlock
                        x:Name="RecoveryErrorText"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ProgressBar
                        x:Name="StepProgress"
                        Margin="0,16,0,0"
                        Minimum="0"
                        Maximum="3"
                        Value="0"
                        AutomationProperties.Name="Setup progress" />

                    <Grid Margin="0,16,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="RetryButton"
                            HorizontalAlignment="Stretch"
                            MinHeight="36"
                            Content="Retry now"
                            Visibility="Collapsed"
                            Click="RetryButton_Click"
                            AccessKey="R"
                            AutomationProperties.Name="Retry now" />
                        <Button
                            x:Name="ChangeSourceButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            MinHeight="36"
                            Content="Change inference source"
                            Click="ChangeSourceButton_Click"
                            AccessKey="C"
                            AutomationProperties.Name="Change inference source" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
